{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/contact.php", "dest": "/api/contact.php" },
    { "src": "/follow.php", "dest": "/api/follow.php" },
    { "src": "/(index.php)?$", "dest": "/api/index.php" },
    { "src": "/404.php", "dest": "/api/404.php" }
  ]
}
